  <ItemGroup><Resource Include="../../assets/deadware.png" Link="Assets/deadware.png" Condition="Exists('../../assets/deadware.png')"/><Resource Include="../../assets/deadware.ico" Link="Assets/deadware.ico" Condition="Exists('../../assets/deadware.ico')"/></ItemGroup>
  <ItemGroup><Resource Include="../../assets/maps/land.json" Link="Assets/maps/land.json"/><Resource Include="../../assets/maps/borders.json" Link="Assets/maps/borders.json"/><Resource Include="../../assets/maps/states.json" Link="Assets/maps/states.json"/><Resource Include="../../assets/maps/cities.json" Link="Assets/maps/cities.json"/></ItemGroup>
