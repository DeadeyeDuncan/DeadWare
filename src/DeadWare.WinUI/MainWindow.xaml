<Window
    x:Class="DeadWare.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarArea">
            <TextBlock x:Name="TitleText" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <!-- The pane is as wide as its longest labels need ("Cooling Health", "Usage history"), not WinUI's default 320. -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            AlwaysShowHeader="False"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.PaneFooter>
                <!-- As at the foot of the WPF sidebar: the way to stop monitoring, what closing does, and what is running. -->
                <StackPanel x:Name="PaneFoot" Margin="12,6,12,10" Spacing="4">
                    <!-- Wraps rather than clips if the narrow pane, a larger text size or a translation leaves it too little room. -->
                    <Button x:Name="ElevateButton" HorizontalAlignment="Stretch" Click="OnElevate">
                        <TextBlock Text="Restart as administrator" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                    <TextBlock x:Name="ElevateResult" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button x:Name="QuitButton" Content="Quit DeadWare" HorizontalAlignment="Stretch" Click="OnQuit" />
                    <TextBlock x:Name="TrayNotice" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="MonitoringInfo" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The page's name, the hardware being watched and how fresh the last sample is, then the shared controls, led by
                     the page's own control if it has one. Kept short so the page below gets the height; the right margin lines the
                     controls up with Overview's cards. The texts trim rather than wrap, so a narrow window keeps the header one row. -->
                <Grid Margin="24,8,16,6" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PageSubtitle" Opacity="0.7" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel x:Name="RangeRow" Orientation="Horizontal" Spacing="2" />
                        <Button x:Name="OpenWidget" Content="Open widget" Click="OnOpenWidget" />
                    </StackPanel>
                </Grid>
                <InfoBar x:Name="UpdateNotice" Grid.Row="1" Margin="24,0,24,8" IsOpen="False" IsClosable="False" Severity="Informational" Message="Install when you are ready.">
                    <InfoBar.ActionButton>
                        <Button Content="Review update" Click="OnReviewUpdate" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="2" />
                <TextBlock x:Name="StatusLines" Grid.Row="3" Margin="32,4,24,10" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
